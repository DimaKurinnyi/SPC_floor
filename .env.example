# Copy to .env.local and fill in. Never commit the real values.

# Public address of the site, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries go. Several addresses can be separated with commas.
LEAD_TO_EMAIL=

# Sender address on a domain verified in Resend, e.g. "SPC Floor <formularz@twojadomena.pl>".
# Before the domain is verified, use "onboarding@resend.dev"; Resend then delivers only
# to the email address of your own Resend account.
LEAD_FROM_EMAIL=
